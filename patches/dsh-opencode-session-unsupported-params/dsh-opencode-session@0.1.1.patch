+
+// Static per-model request-body rules (optional, user-supplied). Rules apply in
+// order to every request sent to opencode.ai whose JSON body `model` matches
+// the rule's case-insensitive `model` regex. `drop` removes top-level body
+// fields; `keep` restores them (a later `keep` beats an earlier `drop`).
+// Default: none. Unsupported fields are learned automatically (see quirk store).
+const DEFAULT_BODY_RULES = []
+
+export function resolveBodyRules(value) {
+  const rules = Array.isArray(value) ? value : DEFAULT_BODY_RULES
+  return rules.flatMap((rule) => {
+    try {
+      const list = (key) => (Array.isArray(rule[key]) ? rule[key].map(String) : [])
+      return [{ model: new RegExp(String(rule.model ?? '.*'), 'i'), drop: list('drop'), keep: list('keep') }]
+    } catch {
+      return [] // invalid regex: ignore the rule
+    }
+  })
+}
+
+/** Return the body fields to remove for `model` after applying all rules. */
+export function fieldsToDrop(rules, model) {
+  const drop = new Set()
+  for (const rule of rules) {
+    if (!rule.model.test(String(model))) continue
+    for (const field of rule.drop) drop.add(field)
+    for (const field of rule.keep) drop.delete(field)
+  }
+  return drop
 }
 
