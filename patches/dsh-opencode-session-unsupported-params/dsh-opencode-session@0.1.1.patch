+// Learned quirks: the first time OpenCode answers 400 `unsupported_parameter`
+// for a top-level body field, remember (model, field) and strip it from then on.
+// Entries expire so a provider that later adds support is rediscovered.
+const QUIRK_TTL_MS = 30 * 24 * 3600 * 1000
+const PROBED_KEY = '__probed' // reserved: models already probed at startup
+
+export function createQuirkStore(file, now = Date.now) {
+  let data = {}
+  if (file) {
+    try { data = JSON.parse(readFileSync(file, 'utf8')) } catch { /* first run */ }
+  }
+  // Tiny file, rare writes: sync write avoids interleaved async writes losing an entry.
+  const save = () => { try { writeFileSync(file, JSON.stringify(data, null, 2), 'utf8') } catch { /* read-only home: stay in memory */ } }
+  return {
+    fields(model) {
+      const out = new Set()
+      if (String(model) === PROBED_KEY) return out
+      for (const [field, at] of Object.entries(data[String(model)] ?? {})) {
+        if (now() - at < QUIRK_TTL_MS) out.add(field)
+      }
+      return out
+    },
+    probed(model) {
+      const at = data[PROBED_KEY]?.[String(model)]
+      return at !== undefined && now() - at < QUIRK_TTL_MS
+    },
+    markProbed(model) {
+      data[PROBED_KEY] = { ...data[PROBED_KEY], [String(model)]: now() }
+      if (file) save()
+    },
+    learn(model, field) {
+      data[String(model)] = { ...data[String(model)], [field]: now() }
+      if (file) save()
+    },
+  }
+}
