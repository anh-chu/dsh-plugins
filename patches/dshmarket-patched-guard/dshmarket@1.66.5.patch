+/**
+ * The profile's own pnpm patches, read into one map keyed by package name.
+ *
+ * Two places carry them and pnpm honours both: `patchedDependencies` at the
+ * top level of pnpm-workspace.yaml, and `pnpm.patchedDependencies` in the
+ * profile manifest. The keys are `name@exactVersion` — pnpm pins the patch
+ * to ONE version, so the entry stops matching the moment the install moves
+ * off it, which is the fact the update guard needs.
+ *
+ * A key with no `@version` applies to every version of that package and is
+ * recorded with `version: null`, so a caller can tell "patched at 0.8.1"
+ * from "patched always".
+ *
+ * Returns an empty map on ANY read or parse failure. This feeds the update
+ * list, and a malformed yaml file must degrade the answer to "no patches
+ * known here" rather than take the whole listing down.
+ */
+export function readPatchedDependencies(profile, explicitDir) {
+    const map = new Map();
+    const add = (entries) => {
+        if (entries === null || typeof entries !== 'object' || Array.isArray(entries))
+            return;
+        for (const [key, file] of Object.entries(entries)) {
+            if (typeof key !== 'string' || key === '')
+                continue;
+            // `lastIndexOf`, not `indexOf`: a scoped name starts with `@`, so
+            // splitting on the first one would read `@scope` as the name and
+            // `pkg` as the version. A key with no version keeps `null`.
+            const at = key.lastIndexOf('@');
+            const name = at > 0 ? key.slice(0, at) : key;
+            const version = at > 0 ? key.slice(at + 1) : null;
+            if (name === '')
+                continue;
+            const existing = map.get(name);
+            // Two entries for one name means the version was already moved on
+            // and the old one left behind. Keep the NEWEST key: that is the
+            // one pnpm still honours, and it is the one a stale second entry
+            // must not be allowed to mask.
+            if (existing !== undefined && existing.version !== null && (version === null || existing.version === version))
+                continue;
+            map.set(name, { key, file: typeof file === 'string' ? file : '', version });
+        }
+    };
+    const dir = profileDir(profile, explicitDir);
+    try {
+        const workspace = loadYaml(readFileSync(join(dir, 'pnpm-workspace.yaml'), 'utf8'));
+        add(workspace?.patchedDependencies ?? null);
+    }
+    catch {
+        // No workspace file, or one that does not parse. The manifest below
+        // may still carry the entries.
+    }
+    try {
+        const manifest = JSON.parse(readFileSync(join(dir, 'package.json'), 'utf8'));
+        add(manifest?.pnpm?.patchedDependencies ?? null);
+    }
