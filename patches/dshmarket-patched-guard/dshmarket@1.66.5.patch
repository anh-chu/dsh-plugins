+ *
+ * A fork records the version it forked FROM plus a local counter — this
+ * profile's convention is `<upstream>-local.N`. That suffix is a prerelease by
+ * semver's rules, and a stable release outranks a prerelease of the same core,
+ * so comparing `0.2.6-local.1` against `0.2.6` reports an upgrade that does not
+ * exist. Strip it before comparing; that is the whole difference between "your
+ * fork is stale" and "you are behind".
+ */
+export function forkBaseVersion(version) {
+    return typeof version === 'string' ? version.replace(/-local\.\d+$/u, '') : version;
+}
+/**
+ * Report upstream for locally installed plugins that are forks of a published
+ * package, across BOTH `file:` and `link:` specs.
+ *
+ * `link:` installs used to be skipped outright as development checkouts, which
+ * left every fork installed that way permanently invisible.
+ *
+ * The upstream is named only when the INSTALLED package's own `repository`
+ * matches npm's `repository` for the same package name. A shared name is not
+ * evidence — an unrelated package that happens to collide would otherwise be
+ * reported as this fork's upstream, which is how a wrong restore gets offered.
+ * A plugin the user wrote declares no repository, so it is simply absent here.
+ */
+async function attachForkUpstream(profile, activeProfileDir, result) {
+    const candidates = Object.entries(result).filter(([, status]) => status.kind === 'linked');
+    await Promise.all(candidates.map(async ([name, status]) => {
+        const manifest = readInstalledManifest(profile, name, activeProfileDir);
+        const declared = repoSlug(manifest?.repository?.url);
+        if (declared === null)
+            return;
+        const meta = await fetchJson(npmUrl(`${encodeURIComponent(name)}/latest`)).catch(() => null);
+        const published = repoSlug(meta?.repository?.url);
+        if (meta === null || typeof meta.version !== 'string' || published !== declared)
+            return;
+        const base = forkBaseVersion(status.version);
+        const behind = isUpgrade(base, meta.version);
+        status.upstream = { repo: declared, latest: meta.version, behind };
+        // Correct the row from the base version, so a fork of a stable release
+        // stops advertising an update it does not have, and one that IS behind
+        // stops being hidden because it was installed by link.
+        status.current = base ?? status.current;
+        status.latest = meta.version;
+        status.updateAvailable = behind;
+        if (behind)
+            status.restoreRequired = true;
+        else
+            delete status.restoreRequired;
+    }));
+}
