+/**
+ * Nearest enclosing git repository root, or null when there is none.
+ *
+ * Used only as a fallback for workspace identity when no `.mnemosyne-id` marker
+ * is present: the repository root is the natural project boundary, and keying on
+ * its canonical path gives a project its own namespace WITHOUT writing a marker
+ * file into the user's repository. A `.git` *file* (worktree or submodule) counts
+ * as a root just as a `.git` directory does.
+ *
+ * The filesystem root and the system temp dir are never accepted as projects.
+ * A stray `/tmp/.git` is enough to make every scratch directory look like a
+ * repository, and binding "the temp dir" as a workspace boundary is nonsense.
+ */
+export function findGitRoot(startDir) {
+  if (typeof startDir !== "string" || !startDir) return null;
+  const refused = new Set([resolve("/"), resolve(tmpdir())]);
+  let dir = resolve(startDir);
+  for (let depth = 0; depth < 32; depth += 1) {
+    if (refused.has(dir)) return null;
+    if (existsSync(join(dir, ".git"))) return dir;
+    const parent = dirname(dir);
+    if (parent === dir) return null;
+    dir = parent;
+  }
+  return null;
+}
