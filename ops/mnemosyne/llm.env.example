# EXAMPLE. Copy to ~/.dsh/mnemosyne/llm.env and adjust. The real file is not committed: it is host
# configuration. The API key below is the literal string "local" because the router is local and
# does not check it; if yours does, keep the real key out of git.
#
# Shared environment for mnemosyne's LLM summariser and working-memory lifecycle.
#
# ONE file, read by three consumers, so they cannot disagree:
#   - dsh.service            (EnvironmentFile= in dsh.service.d/mnemosyne.conf)
#   - mnemosyne-daily.service (EnvironmentFile= in the unit)
#   - interactive shells running ~/.dsh/bin/*.sh (they `source` it)
#
# WHY A FILE AND NOT config.yaml: the engine reads every value below from
# os.environ at import time (core/local_llm.py lines 36-39, core/beam.py TTL).
# The matching config.yaml keys are inert for these. The dsh-mnemosyne plugin's
# buildEnv bridge only forwards ignore_patterns and write_classifier, and only
# to the process the plugin spawns, so it cannot cover the daily timer.
#
# WHY THE TTL MATTERS HERE: any process that runs `mnemosyne` WITHOUT
# MNEMOSYNE_WM_TTL_HOURS trims at the 168-hour default. Every script must load this file.
#
# Format: KEY=value, one per line. No `export`, no command substitution, no `$`.
# systemd and bash both read this file, so keep quoting to plain double quotes.

# --- summariser: the local OpenAI-compatible router --------------------------
# codex/gpt-5.6-luna-low runs on the Codex subscription (cost 0). mneme used the
# same model family (openai-codex:gpt-5.6-luna). auto/* routes are disabled on
# this router and kc/* models need credits, so name the model explicitly.
MNEMOSYNE_LLM_ENABLED=true
MNEMOSYNE_LLM_BASE_URL=http://127.0.0.1:20129/v1
MNEMOSYNE_LLM_MODEL=codex/gpt-5.6-luna-low
MNEMOSYNE_LLM_API_KEY=local
MNEMOSYNE_LLM_TIMEOUT=180
MNEMOSYNE_LLM_MAX_TOKENS=700

# The engine sizes each summary chunk from this window. The default (2048) leaves
# about 1,000 tokens of input, which splits one session into many tiny summaries.
MNEMOSYNE_LLM_N_CTX=24000

# --- lifecycle ---------------------------------------------------------------
# sleep consolidates rows older than TTL/2 (360 h); the trim deletes unconsolidated
# rows older than TTL (720 h). That leaves a 15-day window for the daily timer.
# The old value, 876000 (100 years), made the sleep cutoff land five years in the
# past, so nothing was ever eligible. Migrated rows carry a consolidated_at stamp
# and are exempt from the trim.
MNEMOSYNE_WM_TTL_HOURS=720

# --- summary prompt: English only, conclusions first -------------------------
# Tested on copies: this prompt carries the assistant's findings, where the
# built-in prompt summarised mostly the user's questions. Only {memories} is
# substituted by the engine (it also accepts {source} and {memory_count}), and it
# calls str.format, so do not add any other braces. Keep it on ONE line.
MNEMOSYNE_SLEEP_PROMPT="Write in English only, whatever language the input uses. Summarise the conversation turns below as durable memory for a future session. Lines starting [USER] are the user's requests; lines starting [ASSISTANT] are the assistant's replies. State the decisions made, the facts established with their evidence, and what was left open. Do not list the questions on their own. Plain prose, at most 120 words. {memories}"
