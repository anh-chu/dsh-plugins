{
  "name": "dsh-notepad",
  "version": "0.1.1",
  "description": "Persistent notepad on the right side of the DSH Web GUI: a sticky-note panel pinned to the far right of the page, autosaved to ~/.dsh/notepad/notes.md, readable and writable by the Agent through notepad_read/notepad_write.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "prepublishOnly": "node --check lib/index.js && node --check lib/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "author": "43456-awa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/43456-awa/dsh-notepad.git"
  },
  "homepage": "https://github.com/43456-awa/dsh-notepad",
  "bugs": {
    "url": "https://github.com/43456-awa/dsh-notepad/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "notepad",
    "notes",
    "sticky",
    "plugin"
  ]
}
