{
  "name": "dsh-jev-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One Jev decision layer for DeepSeek Harness. Modular: every feature is off on a fresh install.",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "dsh-jev-layer-core": "file:/home/sil/dsh-plugins/dsh-jev-layer/packages/core"
  }
}
